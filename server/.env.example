# YuE2 服务器配置示例。复制为 .env 或直接 export；切勿把真实密钥提交到仓库。

# 监听地址与端口
YUE2_HOST=0.0.0.0
YUE2_PORT=8420

# 模型（Hugging Face 仓库名或本地已下载目录）
YUE2_MODEL=m-a-p/YuE2-3B
YUE2_VAE=m-a-p/YuE2-Vae

# 运行设备：auto / cuda / cpu（iOS 联调可先用 YUE2_STUB=1 的演示模式）
YUE2_DEVICE=auto
# 显存预算（GiB）：YuE2-3B 未量化预设需要 BF16、建议 ≥24GB
YUE2_MEMORY_BUDGET_GIB=24

# Hugging Face 下载令牌（YuE2-3B 如需要申请权限时必填；也可用 HF_TOKEN）
# YUE2_HF_TOKEN=hf_xxxxxxxx

# 数据目录（任务库 SQLite + 生成的歌曲）
YUE2_DATA_DIR=./data
# 保留最近多少个任务的产物（超出自动清理）
YUE2_KEEP_JOBS=100

# API Key：设置后客户端必须带 X-API-Key 请求头；留空则不校验（仅限内网/本机）
# YUE2_API_KEY=

# Stub 演示模式：=1 时不加载真模型，生成示意音频与乐谱（无 GPU 联调用）
YUE2_STUB=0

# 歌词长度上限（字符）
YUE2_MAX_LYRICS=20000
